{
  "name": "tui-devtools",
  "version": "0.1.0",
  "description": "DevTools for Ink TUI apps — component tree, state inspection, console capture for AI agents",
  "type": "module",
  "bin": {
    "tui-devtools": "./dist/bin/tui-devtools.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tui-devtools.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tui",
    "devtools",
    "ink",
    "react",
    "terminal",
    "debugging",
